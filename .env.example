# Sao chép thành .env.production rồi điền mã thật trước khi `npm run build`.
# Khi chạy `npm run dev` luôn chỉ hiện khung quảng cáo giả, không tải quảng cáo thật.

# Tên miền chính thức (dùng cho sitemap.xml, robots.txt), không có dấu / ở cuối
VITE_SITE_URL=https://ten-mien-cua-ban.vn

# Mạng quảng cáo: none | adsense | ezoic
VITE_AD_PROVIDER=none

# Đặt 1 để bản build chỉ hiện khung giả (xem bố cục trên server thật mà chưa bật quảng cáo)
VITE_AD_PREVIEW=

# ---- Google AdSense ----
# Mã nhà xuất bản: AdSense > Tài khoản > Thông tin tài khoản
VITE_ADSENSE_CLIENT=ca-pub-0000000000000000
# Mã đơn vị quảng cáo (data-ad-slot), tạo trong AdSense > Quảng cáo > Theo đơn vị quảng cáo > Quảng cáo hiển thị hình ảnh
# Nên tạo đơn vị kích thước cố định: TOP 728x90 (điện thoại 320x100), RAIL 160x600, PROCESSING/RESULT 300x250
VITE_AD_SLOT_TOP=
VITE_AD_SLOT_RAIL=
VITE_AD_SLOT_PROCESSING=
VITE_AD_SLOT_RESULT=

# ---- Ezoic ----
# Số placeholder (ezoic-pub-ad-placeholder-XXX) tạo trong bảng điều khiển Ezoic
VITE_EZOIC_ID_TOP=
VITE_EZOIC_ID_RAIL_LEFT=
VITE_EZOIC_ID_RAIL_RIGHT=
VITE_EZOIC_ID_PROCESSING=
VITE_EZOIC_ID_RESULT=
